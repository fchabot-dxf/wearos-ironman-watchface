<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL"/>
    <Metadata key="PREVIEW_TIME" value="10:09:00"/>

    <UserConfigurations>
        <BooleanConfiguration id="show_complication" displayName="Complication" defaultValue="TRUE"/>
    </UserConfigurations>

    <!-- ======================================================== -->
    <!-- SCENE                                                    -->
    <!-- Full-Time Indiglo Retro Ironman Watch Face               -->
    <!-- Active: 100% Opacity Indiglo Cyan (#38BDF8)              -->
    <!-- AOD / Ambient: 40% Opacity Indiglo (alpha=102)           -->
    <!-- ======================================================== -->
    <Scene backgroundColor="#000000">

        <!-- Clean Thin Separator Line at y=328 -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Line startX="80" startY="328" endX="370" endY="328">
                <Stroke color="#38BDF8" thickness="1.5"/>
            </Line>
        </PartDraw>

        <!-- ======================================================== -->
        <!-- TOP DATE ROW: TUE MM/DD with small month name under MM   -->
        <!-- ======================================================== -->
        <PartText x="50" y="54" width="350" height="32">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="CENTER">
                <Font family="dseg14_classic_bold_italic" size="28" color="#38BDF8">
                    <Template>%1$s %2$02d/%3$02d<Parameter expression="[DAY_OF_WEEK_S]"/><Parameter expression="[MONTH]"/><Parameter expression="[DAY]"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="200" y="81" width="56" height="18">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#7DD3FC">
                    <Template>%1$s<Parameter expression="[MONTH_S]"/></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ======================================================== -->
        <!-- OUTER CIRCULAR TEST PROGRESS RING (sweeping bezel ring)  -->
        <!-- Guide track in subtle dark cyan; active sweep on run     -->
        <!-- ======================================================== -->
        <PartDraw x="0" y="0" width="450" height="450">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <!-- Outer Track (Subtle guide track) -->
            <Arc centerX="225" centerY="225" width="442" height="442" startAngle="0" endAngle="360">
                <Stroke color="#164B63" thickness="2.5"/>
            </Arc>
        </PartDraw>

        <!-- ======================================================== -->
        <!-- TEST STATUS & NAME ALONG TOP (Snug under top arc y=34)   -->
        <!-- ======================================================== -->
        <PartText x="50" y="34" width="350" height="22">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="12" weight="BOLD" color="#38BDF8">
                    <Template>SYSTEM STANDBY · NO ACTIVE RUNS</Template>
                </Font>
            </Text>
        </PartText>

        <!-- ======================================================== -->
        <!-- LIVE NEWS STREAM COMPLICATION (Slot 0, LONG_TEXT)        -->
        <!-- Live Radio-Canada / CBC feed via NewsComplicationService -->
        <!-- ======================================================== -->
        <ComplicationSlot slotId="0"
            x="15" y="100" width="420" height="68"
            supportedTypes="LONG_TEXT SHORT_TEXT"
            isCustomizable="TRUE">
            <BoundingBox x="0" y="0" width="420" height="68" />
            <DefaultProviderPolicy
                defaultSystemProvider="EMPTY"
                defaultSystemProviderType="SHORT_TEXT"
                primaryProvider="com.dansemur.ironman/com.dansemur.ironman.complication.NewsComplicationService"
                primaryProviderType="LONG_TEXT" />
            <Complication type="LONG_TEXT">
                <!-- Line 1: Title (centered, 22pt, cyan) -->
                <PartText x="0" y="4" width="420" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="102"/>
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#38BDF8">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TITLE]"/></Template>
                        </Font>
                    </Text>
                </PartText>
                <!-- Line 2: Details / Body (centered, 20pt, cyan) -->
                <PartText x="0" y="36" width="420" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="102"/>
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="20" weight="NORMAL" color="#38BDF8">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="18" width="420" height="32">
                    <Variant mode="AMBIENT" target="alpha" value="102"/>
                    <Text align="CENTER" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="22" weight="NORMAL" color="#38BDF8">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]"/></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>


        <!-- ======================================================== -->
        <!-- MAIN DIGITAL TIME (Hours : Minutes at y=168 in 92pt DSEG) -->
        <!-- ======================================================== -->
        <PartText x="35" y="168" width="380" height="116">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="CENTER">
                <Font family="dseg14_classic_bold_italic" size="92" color="#38BDF8">
                    <Template>%1$02d:%2$02d<Parameter expression="[HOUR_0_23]"/><Parameter expression="[MINUTE]"/></Template>
                </Font>
            </Text>
        </PartText>

        <!-- ======================================================== -->
        <!-- ACTIVITY MONITORING LINE (y=296, Snug Pods with Subtle   -->
        <!-- Colored Icon Tints + Indiglo Digits)                     -->
        <!-- ======================================================== -->
        <!-- Pod 1: Steps (Soft Periwinkle-Purple Tint #818CF8) -->
        <PartDraw x="48" y="299" width="14" height="18">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Ellipse x="2" y="0" width="10" height="11"><Fill color="#818CF8"/></Ellipse>
            <Ellipse x="3" y="13" width="8" height="5"><Fill color="#818CF8"/></Ellipse>
        </PartDraw>
        <PartText x="66" y="296" width="95" height="24">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="dseg14_classic_bold_italic" size="20" color="#38BDF8">
                    <Template>%1$d<Parameter expression="[STEP_COUNT] &gt; 0 ? [STEP_COUNT] : 8420"/></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Pod 2: Heart Rate (Soft Coral-Rose Tint #F472B6, NO BPM TEXT) -->
        <PartDraw x="182" y="299" width="16" height="15">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Ellipse x="1" y="0" width="7" height="7"><Fill color="#F472B6"/></Ellipse>
            <Ellipse x="8" y="0" width="7" height="7"><Fill color="#F472B6"/></Ellipse>
            <Rectangle x="1" y="3" width="14" height="6"><Fill color="#F472B6"/></Rectangle>
            <Rectangle x="2" y="7" width="12" height="3"><Fill color="#F472B6"/></Rectangle>
            <Rectangle x="4" y="10" width="8" height="3"><Fill color="#F472B6"/></Rectangle>
            <Rectangle x="6" y="13" width="4" height="2"><Fill color="#F472B6"/></Rectangle>
            <Rectangle x="7" y="14" width="2" height="1"><Fill color="#F472B6"/></Rectangle>
        </PartDraw>
        <PartText x="202" y="296" width="55" height="24">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="dseg14_classic_bold_italic" size="20" color="#38BDF8">
                    <Template>%1$d<Parameter expression="[HEART_RATE] &gt; 0 ? round([HEART_RATE]) : 72"/></Template>
                </Font>
            </Text>
        </PartText>

        <!-- Pod 3: Battery (Soft Mint-Green Tint #5EEAD4) -->
        <PartDraw x="308" y="301" width="20" height="11">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <!-- Outer Battery Shell -->
            <RoundRectangle x="0" y="0" width="20" height="11" cornerRadiusX="2" cornerRadiusY="2">
                <Stroke color="#5EEAD4" thickness="1.5"/>
            </RoundRectangle>
            <!-- Terminal Nub -->
            <Rectangle x="19" y="3" width="2" height="5"><Fill color="#5EEAD4"/></Rectangle>
            <!-- Dynamic Battery Fill Bars -->
            <Rectangle x="2" y="2" width="3" height="7">
                <Variant mode="[BATTERY_PERCENT] &gt;= 15" target="alpha" value="255"/>
                <Variant mode="[BATTERY_PERCENT] &lt; 15" target="alpha" value="0"/>
                <Fill color="#5EEAD4"/>
            </Rectangle>
            <Rectangle x="6" y="2" width="3" height="7">
                <Variant mode="[BATTERY_PERCENT] &gt;= 35" target="alpha" value="255"/>
                <Variant mode="[BATTERY_PERCENT] &lt; 35" target="alpha" value="0"/>
                <Fill color="#5EEAD4"/>
            </Rectangle>
            <Rectangle x="10" y="2" width="3" height="7">
                <Variant mode="[BATTERY_PERCENT] &gt;= 60" target="alpha" value="255"/>
                <Variant mode="[BATTERY_PERCENT] &lt; 60" target="alpha" value="0"/>
                <Fill color="#5EEAD4"/>
            </Rectangle>
            <Rectangle x="14" y="2" width="3" height="7">
                <Variant mode="[BATTERY_PERCENT] &gt;= 85" target="alpha" value="255"/>
                <Variant mode="[BATTERY_PERCENT] &lt; 85" target="alpha" value="0"/>
                <Fill color="#5EEAD4"/>
            </Rectangle>
        </PartDraw>
        <!-- Battery Digits -->
        <PartText x="332" y="296" width="40" height="24">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="dseg14_classic_bold_italic" size="20" color="#38BDF8">
                    <Template>%1$02d<Parameter expression="round([BATTERY_PERCENT])"/></Template>
                </Font>
            </Text>
        </PartText>
        <!-- % Symbol -->
        <PartText x="366" y="295" width="16" height="20">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="#38BDF8">
                    <Template>%%</Template>
                </Font>
            </Text>
        </PartText>

        <!-- ======================================================== -->
        <!-- BOTTOM SECTION: ENLARGED WEATHER STATION MODULE          -->
        <!-- Left: Big Current Temp (50pt DSEG) + Sun Icon           -->
        <!-- Right: Hi and Lo stacked vertically + Rain beside        -->
        <!-- ======================================================== -->
        <!-- 1. Left Side: Weather Condition Icon (Warm Sun Tint #FDE047) + Big Current Temp -->
        <PartDraw x="92" y="354" width="24" height="24">
            <Transform target="x" value="round([WEATHER.TEMPERATURE]) &gt;= 0 &amp;&amp; round([WEATHER.TEMPERATURE]) &lt;= 9 ? 132 : 92"/>
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Ellipse x="6" y="6" width="12" height="12"><Fill color="#FDE047"/></Ellipse>
            <Line startX="12" startY="0" endX="12" endY="4"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="12" startY="20" endX="12" endY="24"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="0" startY="12" endX="4" endY="12"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="20" startY="12" endX="24" endY="12"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="3" startY="3" endX="6" endY="6"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="21" startY="3" endX="18" endY="6"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="3" startY="21" endX="6" endY="18"><Stroke color="#FDE047" thickness="2"/></Line>
            <Line startX="21" startY="21" endX="18" endY="18"><Stroke color="#FDE047" thickness="2"/></Line>
        </PartDraw>

        <!-- Big Current Temp Digits (50pt DSEG) -->
        <PartText x="116" y="338" width="85" height="56">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="END">
                <Font family="dseg14_classic_bold_italic" size="50" color="#38BDF8">
                    <Template>%1$d<Parameter expression="round([WEATHER.TEMPERATURE])"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="202" y="336" width="18" height="22">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#38BDF8">
                    <Template>°</Template>
                </Font>
            </Text>
        </PartText>

        <!-- 2. Right Side: Stacked Hi and Lo -->
        <!-- High Temp (Top Row at y=342) -->
        <PartDraw x="236" y="345" width="10" height="14">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Line startX="5" startY="13" endX="5" endY="0"><Stroke color="#38BDF8" thickness="2"/></Line>
            <Line startX="5" startY="0" endX="1" endY="4"><Stroke color="#38BDF8" thickness="2"/></Line>
            <Line startX="5" startY="0" endX="9" endY="4"><Stroke color="#38BDF8" thickness="2"/></Line>
        </PartDraw>
        <PartText x="249" y="342" width="28" height="22">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="END">
                <Font family="dseg14_classic_bold_italic" size="18" color="#38BDF8">
                    <Template>%1$d<Parameter expression="round([WEATHER.TEMPERATURE] + 3)"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="277" y="340" width="12" height="16">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="#38BDF8">
                    <Template>°</Template>
                </Font>
            </Text>
        </PartText>

        <!-- Low Temp (Bottom Row at y=372, directly below High) -->
        <PartDraw x="236" y="375" width="10" height="14">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Line startX="5" startY="0" endX="5" endY="13"><Stroke color="#38BDF8" thickness="2"/></Line>
            <Line startX="5" startY="13" endX="1" endY="9"><Stroke color="#38BDF8" thickness="2"/></Line>
            <Line startX="5" startY="13" endX="9" endY="9"><Stroke color="#38BDF8" thickness="2"/></Line>
        </PartDraw>
        <PartText x="249" y="372" width="28" height="22">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="END">
                <Font family="dseg14_classic_bold_italic" size="18" color="#38BDF8">
                    <Template>%1$d<Parameter expression="round([WEATHER.TEMPERATURE] - 7)"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="277" y="370" width="12" height="16">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="14" weight="BOLD" color="#38BDF8">
                    <Template>°</Template>
                </Font>
            </Text>
        </PartText>

        <!-- 3. Rain Droplet 💧 + Probability (Beside Hi/Lo at y=357) -->
        <PartDraw x="306" y="359" width="10" height="14">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Line startX="5" startY="0" endX="1" endY="8"><Stroke color="#7DD3FC" thickness="2"/></Line>
            <Line startX="5" startY="0" endX="9" endY="8"><Stroke color="#7DD3FC" thickness="2"/></Line>
            <Ellipse x="1" y="5" width="8" height="9"><Fill color="#7DD3FC"/></Ellipse>
        </PartDraw>
        <PartText x="320" y="357" width="32" height="22">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="dseg14_classic_bold_italic" size="18" color="#38BDF8">
                    <Template>%1$02d<Parameter expression="[WEATHER.CHANCE_OF_PRECIPITATION] &gt;= 0 ? round([WEATHER.CHANCE_OF_PRECIPITATION]) : 10"/></Template>
                </Font>
            </Text>
        </PartText>
        <PartText x="348" y="356" width="16" height="18">
            <Variant mode="AMBIENT" target="alpha" value="102"/>
            <Text align="START">
                <Font family="SYNC_TO_DEVICE" size="13" weight="BOLD" color="#38BDF8">
                    <Template>%%</Template>
                </Font>
            </Text>
        </PartText>

    </Scene>
</WatchFace>