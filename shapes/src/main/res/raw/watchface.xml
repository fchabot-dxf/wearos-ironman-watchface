        <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="0">
            <Transform target="angle" value="([MINUTE] + [SECOND] / 60) * 6"/>
            <Line startX="225" startY="244" endX="225" endY="42"><Stroke color="#FFFFFF" thickness="8" cap="ROUND"/></Line>
        </PartDraw>

        <!-- ================= SECOND HAND (toggle in Customize) ================= -->
        <BooleanConfiguration id="show_seconds">
            <BooleanOption id="TRUE">
                <Group name="seconds" x="0" y="0" width="450" height="450">
                    <Variant mode="AMBIENT" target="alpha" value="0"/>
                    <PartDraw x="0" y="0" width="450" height="450" pivotX="0.5" pivotY="0.5" angle="0">
                        <Transform target="angle" value="[SECOND] * 6"/>
                        <Line startX="225" startY="262" endX="225" endY="36"><Stroke color="#FFC24D" thickness="3" cap="ROUND"/></Line>
                    </PartDraw>
                </Group>
            </BooleanOption>
        </BooleanConfiguration>

        <!-- ================= CENTER CAP ================= -->
        <PartDraw x="211" y="211" width="28" height="28">
            <Ellipse x="3" y="3" width="22" height="22"><Fill color="#000000"/><Stroke color="#FFFFFF" thickness="5"/></Ellipse>
        </PartDraw>
    </Scene>
</WatchFace>
